{
  "name": "research-health-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node --env-file-if-exists=.env backend/server.js",
    "data:download": "node scripts/download-datasets.mjs",
    "data:download:amr": "node scripts/download-bvbrc-amr.mjs",
    "data:acquire:bvbrc-ast": "node scripts/acquire-bvbrc-ast.mjs",
    "data:process": "node scripts/process-datasets.mjs",
    "data:process:amr": "node scripts/process-bvbrc-amr.mjs",
    "data:audit:amr-scope": "python scripts/audit_amr_scope.py",
    "data:fasta:preflight": "node scripts/fasta-preflight.mjs",
    "data:amr:sequence:prepare": "node scripts/prepare-amr-sequence-input.mjs",
    "data:amr:sequence:parse": "node scripts/parse-amrfinder-output.mjs",
    "data:amr:sequence:call": "node scripts/run-amrfinder-plus.mjs",
    "data:amr:sequence:call:docker": "node scripts/run-amrfinder-docker.mjs",
    "data:amr:sequence:map": "node scripts/map-amr-sequence-features.mjs",
    "data:amr:sequence:predict": "node scripts/predict-amr-sequence.mjs",
    "data:amr:sequence:train": "python ml-service/train_sequence_amr.py",
    "data:build:amr-genome-catalog": "python ml-service/build_genome_catalog.py",
    "data:build:amr-vocabulary": "python ml-service/build_vocabulary.py --cohort data/amr_2m/processed/amr_baseline_cohort.jsonl --output data/models/amr_feature_vocabulary.json --model-version amr-sgd-feature-baseline-1 --dataset-version amr-baseline-cohort-a3c7b549296846c1 --expected-source-sha256 a3c7b549296846c61eca74d2733c048fcbf1a2aa809f11c86fe673e7bdf6141e",
    "data:enrich:amr:2m": "node scripts/enrich-bvbrc-amr-2m-sqlite.mjs",
    "data:convert:amr-caches": "node scripts/convert-amr-caches-to-jsonl.mjs data/amr_2m/processed/bvbrc_genome_metadata_cache.json data/amr_2m/processed/bvbrc_resistance_features_cache.json",
    "data:normalize-phenotypes": "node scripts/normalize-phenotypes.mjs",
    "test:contract": "node scripts/validate-contract.mjs",
    "test:api": "node --test backend/test/*.test.js",
    "test:fasta-preflight": "node --test scripts/test-fasta-preflight.test.mjs",
    "test:bvbrc-ast-acquisition": "node --test scripts/test-bvbrc-ast-acquisition.test.mjs",
    "test:amr-sequence-contract": "node --test scripts/test-amr-sequence-contract.test.mjs",
    "test:amr-caller-adapter": "node --test scripts/test-amrfinder-adapter.test.mjs",
    "test:amr-feature-mapping": "node --test scripts/test-amr-feature-mapping.test.mjs",
    "test:amr-sequence-prediction": "node --test scripts/test-amr-sequence-prediction.test.mjs",
    "test:amr-scope-audit": "python -m unittest discover -s scripts -p test_audit_amr_scope.py -v",
    "test:phase6a4": "npm run test:contract && npm run test:api && python -m unittest discover -s ml-service -p test_baselines.py -v",
    "check": "npm run test:contract && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "stream-json": "^3.7.0",
    "vite": "latest"
  }
}
